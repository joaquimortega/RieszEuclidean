    min R (R - t) - max (-R) (-R - t) = 2 * R - |t| := by
  by_cases ht : 0 ≤ t
  · rw [abs_of_nonneg ht, min_eq_right (by linarith), max_eq_left (by linarith)]
    ring
  · have ht' : t ≤ 0 := le_of_not_ge ht
    rw [abs_of_nonpos ht', min_eq_left (by linarith), max_eq_right (by linarith)]
    ring
