  · intro z hz hf
    have h := hfar z hz
    have heq := he z
    have hn : ‖z - p‖ = 0 := by
      nlinarith [sq_nonneg ‖z - p‖, norm_nonneg (z - c), norm_nonneg (z - p)]
    exact sub_eq_zero.mp (norm_eq_zero.mp hn)

end RieszEuclidean

