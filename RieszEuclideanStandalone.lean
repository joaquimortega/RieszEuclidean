      ∫ θ, (Real.fourierChar (inner (𝕜 := ℝ) y θ) : ℂ) ∂τ) : σ = τ := by
  refine ext_of_integral_char_eq Real.continuous_fourierChar Real.fourierChar_ne_one
    (V := Euclidean d) (W := Euclidean d) (L := bilinFormOfRealInner) ?_ ?_ ?_
