  intro Γ h
  have hc : ∀ x : ↥(Γ ∩ K), ∃ y : t, dist (x : Euclidean d) y < δ / 3 := by
    intro x
    obtain ⟨y, hy, hxy⟩ := Set.mem_iUnion₂.mp (hcover x.property.2)
