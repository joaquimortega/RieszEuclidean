noncomputable section
namespace RieszEuclidean
/-- A bump with a positive Fourier lower bound gives an invertible multiplier on the domain. -/
def bumpFourierMultiplier {d : ℕ} (Ω : Set (Euclidean d)) (hΩ : MeasurableSet Ω)
