  let Δ : SeparatedConfiguration d δ := ⟨S, hs.isClosed hδ, hs⟩
  have ht : Tendsto (fun n => Γ (φ (ψ n))) atTop (nhds Δ) := tendsto_of_weaklyConverges hw
