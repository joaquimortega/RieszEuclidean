    (y : Euclidean d) :
    volume.real (euclideanBox d R ∩ translate y (euclideanBox d R)) =
      ∏ j : Fin d, max 0 (2 * R - |y j|) := by
  rw [Measure.real, volume_euclideanBox_inter_translate hR y, ENNReal.toReal_prod]
  simp only [ENNReal.toReal_ofReal', max_comm]
