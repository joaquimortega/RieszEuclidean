  have haK : aK ∈ compactRestriction K (Γ n) (hΓ n) := ha
  obtain ⟨b, hb, hab⟩ := hcn.1 aK haK
  refine ⟨b, hb, ?_⟩
  have ht := dist_triangle (⟨x, hxK⟩ : K) aK b
  have hxa' : dist (⟨x, hxK⟩ : K) aK < ε / 2 :=
    hxa.trans_le (min_le_right _ _)
  linarith
end RieszEuclidean

