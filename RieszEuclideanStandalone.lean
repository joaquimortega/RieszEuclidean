  · have hf : ‖f x‖ ≤ ε := by
      simpa [Metric.mem_closedBall, dist_zero_right] using hfK hx
    have hbabs : |1 - b x| ≤ 1 := by
      rw [abs_of_nonneg (sub_nonneg.mpr (hb x).2)]
