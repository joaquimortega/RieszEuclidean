theorem exists_conull_sequences_two_sides {d : ℕ} {G Ω : Set (Euclidean d)}
    (hG : volume Gᶜ = 0) (hΩ : IsOpen Ω) {x : Euclidean d}
    (hin : x ∈ closure Ω) (hout : x ∈ closure (closure Ω)ᶜ) :
    (∃ t : ℕ → Euclidean d, (∀ n, t n ∈ G ∩ Ω) ∧ Tendsto t atTop (𝓝 x)) ∧
