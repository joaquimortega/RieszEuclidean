theorem bumpKernel_eq_single {d : ℕ} {δ r : ℝ} {Γ : Set (Euclidean d)}
    (hΓ : Separated δ Γ) (hr : 2 * r ≤ δ) (b : Euclidean d → ℂ)
    (hs : ∀ x, r ≤ ‖x‖ → b x = 0) {v : Euclidean d} (w : Euclidean d)
