    dsimp [A] at h
    nlinarith
  let i : Λ := ⟨ξ, hξ⟩
  let j : Λ := ⟨η, hη⟩
  have hij : i ≠ j := fun h => hne (congrArg Subtype.val h)
  have hlower := hcols i j hij
  have hae : ∀ᵐ x ∂volume.restrict Ω,
