    (T : Euclidean d → X → X) (hT : Measurable (fun p : X × Euclidean d => T p.2 p.1))
    (hμ : ∀ v, MeasurePreserving (T v) μ μ) (f : Lp ℂ 2 μ) {R : ℝ} (hR : 0 < R)
