  rw [openSegment_eq_image_lineMap, hausdorffMeasure_lineMap_image,
    hausdorffMeasure_real, Real.volume_Ioo]
  simp only [sub_zero, ENNReal.ofReal_one]
  rw [← Algebra.algebraMap_eq_smul_one]
