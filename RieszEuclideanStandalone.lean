theorem integratedUnitary_congr_ae (U : Euclidean d → H ≃ₗᵢ[ℂ] H)
    {a b : Euclidean d → ℂ} (hab : a =ᵐ[volume] b) (f : H) :
    integratedUnitary U a f = integratedUnitary U b f := by
  apply integral_congr_ae
  filter_upwards [hab] with y hy
  rw [hy]
