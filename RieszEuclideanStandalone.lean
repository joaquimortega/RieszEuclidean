theorem exists_invariant_probability_euclidean_action {d : ℕ} {X : Type*}
    [TopologicalSpace X] [T2Space X] [CompactSpace X] [HasOuterApproxClosed X]
    [MeasurableSpace X] [BorelSpace X]
