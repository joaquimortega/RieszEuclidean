/-- Literal length measure on the relative interior of a Euclidean edge. -/
def edgeLengthMeasure {d : ℕ} (a b : Euclidean d) : Measure (Euclidean d) :=
  (Measure.hausdorffMeasure 1).restrict (openSegment ℝ a b)

