    ext f
    filter_upwards [domainCutoff_coe Ω hΩ (domainCutoff Ω hΩ f),
      domainCutoff_coe Ω hΩ f] with x h1 h2
    change (domainCutoff Ω hΩ (domainCutoff Ω hΩ f) : Euclidean d → ℂ) x =
      (domainCutoff Ω hΩ f : Euclidean d → ℂ) x
