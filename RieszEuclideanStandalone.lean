          (isometryRangeProjection (bumpSynthesis Δ.separated hr b hs hn)).op‖ ≤ γ := by
  classical
  obtain ⟨δ, hδ, hΛ⟩ := riesz_frequencies_separated hΩ hb hB
  obtain ⟨r, hr, hrδ, b, hbs, hn, hp, hz, c, hc, hl⟩ := exists_bump_fourier_lower hb hδ
