/-- Multiplication by a positive-radius Fejér weight preserves integrability. -/
theorem integrable_fejerWeight_smul {d : ℕ} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] {f : Euclidean d → E}
