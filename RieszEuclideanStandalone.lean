  have hd : Dense G := Measure.dense_of_ae (μ := volume) hG
  apply mem_closure_iff_seq_limit.mp
  simpa only [closure_closure, Set.inter_comm] using
    closure_mono (hd.open_subset_closure_inter hO) hx
