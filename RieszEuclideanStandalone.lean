  have hd' := hd.clm_apply (hasDerivAt_const t v)
  have hsecond : HasDerivAt (deriv (fun s : ℝ => f (u + s • v)))
      (fderiv ℝ (fderiv ℝ f) (u + t • v) v v) t := by
    apply HasDerivAt.congr_of_eventuallyEq _ he
    simpa using hd'
