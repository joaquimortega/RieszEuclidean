theorem domainCutoff_coe {d : ℕ} (Ω : Set (Euclidean d)) (hΩ : MeasurableSet Ω)
    (f : FullL2 d) : (domainCutoff Ω hΩ f : Euclidean d → ℂ) =ᵐ[volume] Ω.indicator f :=
