    (hf : HasStrictFDerivAt f L a) (hL : LinearMap.range L = ⊤)
    (hC : ContDiffAt ℝ 2 f a) :
    ContDiffAt ℝ 2 (hf.implicitFunction f L hL (f a)) 0 := by
