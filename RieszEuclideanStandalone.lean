    (hg : HasCompactSupport g) (y : Euclidean d) : SchwartzMap (Euclidean d) ℂ :=
  compactSchwartz (fun x => g (x + y))
    (g.smooth'.comp (contDiff_id.add contDiff_const))
    (hg.comp_homeomorph (Homeomorph.addRight y))
