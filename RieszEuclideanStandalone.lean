    have hR0 : 0 ≤ R := (boxNorm_nonneg z).trans hR
    exact div_le_div_of_nonneg_right (volume_real_box_symmDiff_le R z hR)
      (pow_nonneg (by positivity) _)
end RieszEuclidean

