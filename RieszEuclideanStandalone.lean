  intro a ha
  by_contra hnot
  have hfzero (x : Euclidean d) (hx : dist a x ≤ 1) : f x = 0 := by
    by_contra hxne
    exact hnot (mem_cthickening_of_dist_le a x 1 (tsupport f)
      (subset_tsupport f hxne) hx)
