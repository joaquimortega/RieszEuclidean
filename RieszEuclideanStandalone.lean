      eLpNorm ((f : Euclidean d → ℂ) - (g : Euclidean d → ℂ)) 2 volume := by
    apply eLpNorm_congr_ae
    filter_upwards [g.coeFn_toLp 2 volume] with x hx
    simp only [Pi.sub_apply, hx]
  rw [heq]
  exact ENNReal.toReal_lt_of_lt_ofReal hg

