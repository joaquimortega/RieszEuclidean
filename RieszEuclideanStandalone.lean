  · exact mul_right_inj' (inv_ne_zero (norm_ne_zero_iff.mpr (hn j)))
  · exact forall_congr' fun i => imp_congr_right fun _ =>
      mul_lt_mul_left (inv_pos.mpr (norm_pos_iff.mpr (hn i)))

