  refine ⟨paperFourierL2 d, fun f hf => paperFourierL2_eq_integral f hf, ?_⟩
  intro Ω hΩ hfin
  refine ⟨fourierProjection Ω hΩ, ?_, ?_, ?_⟩
  · intro f
    rw [fourierProjection_transform]
