    ∃ g : SchwartzMap (Euclidean d) ℂ,
      eLpNorm (f - (g : Euclidean d → ℂ)) 2 volume < ε := by
  obtain ⟨η, hη, hηε⟩ := ENNReal.exists_nnreal_pos_mul_lt (a := 2) (by norm_num) hε
  have hη0 : (η : ℝ≥0∞) ≠ 0 := by exact_mod_cast hη.ne'
