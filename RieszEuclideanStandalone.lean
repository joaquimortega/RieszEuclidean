  have ht : Tendsto φ (nhds 0) (nhds p) := hφ0 ▸ hφd.continuousAt.tendsto
  refine ⟨{
    point := p
    functional := L
    functional_ne_zero := hL p hpV
    chart := φ
    projection := P
    neighborhood := W
    isOpen_neighborhood := Metric.isOpen_ball
    point_mem := ⟨Metric.mem_ball_self hδ, hpS⟩
    chart_zero := hφ0
    chart_deriv := hφd
    chart_mem := ?_
