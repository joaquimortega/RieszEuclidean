    contrapose! hL
    ext u
    exact hL u
  have hv : ∃ v, L v = 0 ∧ M v ≠ 0 := by
    by_contra! hv
    apply hM (M u / L u)
    ext x
    have hz : L (x - (L x / L u) • u) = 0 := by
      simp [hu]
    have hm := hv _ hz
    simp only [map_sub, map_smul, smul_eq_mul] at hm
    change M x = (M u / L u) * L x
    have he : M x = (L x / L u) * M u := sub_eq_zero.mp hm
    rw [he]
    ring
  obtain ⟨v, hvL, hvM⟩ := hv
  intro y
  refine ⟨(y.1 / L u) • u + ((y.2 - (y.1 / L u) * M u) / M v) • v, ?_⟩
  apply Prod.ext
  · simp [hvL, hu]
  · simp [hvM]

