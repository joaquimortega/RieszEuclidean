  have hpu : ‖Rp u‖ = 1 := by nlinarith [norm_nonneg (Rp u)]
  exact ⟨hmu, projection_range_lt_of_unit_witness Rm Rp hRms hRps hRmi hRpi horder u hu hmu hpu⟩
