      ∫ θ, (‖integratedKernelSymbol a θ‖ : ℂ) ^ 2 ∂σ := by
    calc
      (‖integratedUnitary U a f‖ : ℂ) ^ 2 =
          ∫ y, ∫ w, star (a w) * a y * unitaryCorrelation U f (y - w) :=
        integratedUnitary_norm_sq U hU hadd ha f
