      apply integral_congr_ae
      filter_upwards [] with y
      simp [inner_smul_left, adjointKernel]
    _ = ∫ y, a y * inner (𝕜 := ℂ) (U (-y) g) f := by
      simpa using (integral_neg_eq_self
        (fun y => a (-y) * inner (𝕜 := ℂ) (U y g) f) volume).symm
