  have hzero : ∀ Δ v, v ∉ K → F Δ v = 0 := by
    intro Δ v hv
    apply bumpKernel_integral_eq_zero_of_radius Δ.carrier b g hs hgzero
    exact lt_of_not_ge (by simpa [K] using hv)
