    (u : H) (hu : ‖u‖ = 1) (hσu : σ u = Measure.dirac 0)
    (M : Euclidean d → H →L[ℂ] H) (hM : ContinuousAt M t₀)
    (hMs : IsSelfAdjoint (M t₀)) (hMi : (M t₀).comp (M t₀) = M t₀)
