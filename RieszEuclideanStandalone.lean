    (hH : Continuous H) :
    (∫ v in euclideanBox d R, ∫ w in euclideanBox d R, H (v - w)) =
      ∫ y, (volume.real (euclideanBox d R ∩ translate y (euclideanBox d R)) : ℂ) * H y := by
