  refine ⟨δ, r, hδ, hr, hrδ, Γ, b, hz, hn, rfl, hbs, hp, ?_⟩
  exact exists_uniform_bump_projection_hull_gap Ω hΩ hb.measure_lt_top.ne Γ hδ hrδ b hz hn hgap
end RieszEuclidean
