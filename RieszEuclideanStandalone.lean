    · nlinarith [mul_pos hrp (sub_pos.mpr har), mul_nonneg hs (sub_nonneg.mpr hbr.le)]
    · nlinarith [mul_nonneg hr (sub_nonneg.mpr har.le), mul_pos hsp (sub_pos.mpr hbr)]

