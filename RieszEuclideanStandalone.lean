    {C : ℝ} (hC : ∀ x, ‖g x‖ ≤ C) {s : Set (Euclidean d)} (hs : volume s < ⊤) :
    IntegrableOn g s volume :=
  (integrableOn_const.mpr (Or.inr hs) : IntegrableOn (fun _ => C) s volume).mono'
    hg.aestronglyMeasurable (Eventually.of_forall hC)
