theorem integratedKernelSymbol_eq_fourierInv (a : Euclidean d → ℂ) (θ : Euclidean d) :
    integratedKernelSymbol a θ = Real.fourierIntegralInv a θ := by
  rw [integratedKernelSymbol, Real.fourierIntegralInv_eq]
