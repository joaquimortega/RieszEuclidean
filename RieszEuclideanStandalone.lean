    {K : Set (Euclidean d)} (hK : IsCompact K) :
    ∃ N : ℕ, ∀ Γ : Set (Euclidean d), Separated δ Γ → (Γ ∩ K).ncard ≤ N := by
  classical
  obtain ⟨t, ht, hcover⟩ := Metric.totallyBounded_iff.mp hK.totallyBounded (δ / 3) (by positivity)
