  intro R hR ε hε
  by_contra hbad
  simp only [not_exists, not_forall, _root_.not_imp, exists_prop] at hbad
  obtain ⟨φ, hφ, hbadφ⟩ := extraction_of_frequently_atTop (frequently_atTop.mpr hbad)
