  rw [exponential_eq_phase, exponential_eq_phase]
  calc
    _ ≤ 2 * |2 * Real.pi * inner (𝕜 := ℝ) ξ x - 2 * Real.pi * inner (𝕜 := ℝ) η x| :=
      phase_exp_sub_le (hphase.trans_lt hsmall)
    _ ≤ 2 * (2 * Real.pi * ‖ξ - η‖ * R) := mul_le_mul_of_nonneg_left hphase (by norm_num)
