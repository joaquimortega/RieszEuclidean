theorem integratedUnitaryCLM_apply (U : Euclidean d → H ≃ₗᵢ[ℂ] H)
    (hU : ∀ f, Continuous (fun y => U y f)) {a : Euclidean d → ℂ}
    (ha : Integrable a) (f : H) :
    integratedUnitaryCLM U hU ha f = ∫ y, a y • U y f := rfl
