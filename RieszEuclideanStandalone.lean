  obtain ⟨tm, tp, Rm, Rp, _, htm, htp, hRm, hRp, hRmt, hRpt, hRmn, hRpn⟩ :=
    exists_boundary_cutoff_limits hΩ hG hx hout σ hfinite hclean P hP hnorm hdiff
