    refine ⟨domainRestriction Ω f, ?_⟩
    change domainExtension Ω hΩ (domainRestriction Ω f) = f
    rw [domainExtension_restriction]
    exact ((domainProjection Ω hΩ).mem_range_iff f).mp hf
end RieszEuclidean

