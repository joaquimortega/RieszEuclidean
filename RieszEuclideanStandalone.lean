      volume.real (euclideanBox d R) := by
  rw [volume_real_euclideanBox_inter_translate hR.le y, volume_real_euclideanBox d hR.le]
  have hden : (2 * R) ^ d = ∏ _j : Fin d, 2 * R := by simp
  rw [hden, ← Finset.prod_div_distrib]
