    ∃ K ⊆ U, (Measure.hausdorffMeasure (Module.finrank ℝ E : ℝ)) K ≠ 0 ∧
      (Measure.hausdorffMeasure (Module.finrank ℝ E : ℝ)) K ≠ ⊤ := by
  obtain ⟨D, hD, happ⟩ := hd.approximates_deriv_on_nhds
    (Or.inr (show (0 : ℝ≥0) < 1 by norm_num))
