  have hg' : Integrable (fun x => starRingEnd ℂ (g x)) :=
    Complex.conjCLE.toContinuousLinearMap.integrable_comp hg
  simpa only [fourier_conj_eq_conj_inverse] using integral_fourier_mul hf hg'

