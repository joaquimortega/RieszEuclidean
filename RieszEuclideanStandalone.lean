  have hga := hg a 0 (fun x hx => by
    have hfx := hfzero x ((by simpa [dist_comm] using hx : dist a x < r).le.trans hr1)
    simp [hfx, hfa])
  have : g a = 0 := by simpa [hfa] using hga
  exact ha this

