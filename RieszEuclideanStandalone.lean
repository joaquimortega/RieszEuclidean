  intro x hx
  obtain ⟨n, hn⟩ := exists_nat_ge ‖x‖
  exact Set.mem_iUnion.mpr ⟨n, hx, by simpa using hn⟩
/-- A configuration with a positive uniform separation constant is closed. -/
