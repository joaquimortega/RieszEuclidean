    (x : Euclidean d) :
    𝓕 (fun y => starRingEnd ℂ (f y)) x = starRingEnd ℂ (𝓕⁻ f x) := by
  rw [Real.fourierIntegral_eq, Real.fourierIntegralInv_eq, ← integral_conj]
  congr 1
  ext y
  simp [Circle.smul_def, map_mul]

