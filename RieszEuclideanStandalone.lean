    _ ≤ ∫ y, (2 * Real.pi * ‖t - s‖ * ‖f‖) * (‖y‖ * C y) := by
      apply norm_integral_le_of_norm_le hb
      exact Filter.Eventually.of_forall fun y => by
        rw [← sub_smul, norm_smul]
