    (hodd : Odd (Nat.card {S : Set (Euclidean 2) //
      IsMaximalBoundarySegment (strictHalfspaceIntersection normal offset) S}))
    (hrep : ∀ {δ : ℝ} (hδ : 0 < δ) (Γ : SeparatedConfiguration 2 δ)
