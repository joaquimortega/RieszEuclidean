    ‖domainRestriction Ω f‖ ≤ ‖f‖ := by
  rw [Lp.norm_def, Lp.norm_def]
  rw [eLpNorm_congr_ae (domainRestriction_coe Ω f)]
  exact ENNReal.toReal_mono (Lp.memLp f).eLpNorm_ne_top
