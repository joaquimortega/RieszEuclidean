  · intro x hx hnorm
    have hxK : x ∈ Metric.closedBall (0 : Euclidean d) (k + 1 : ℝ) := by
      simpa using (le_of_lt (hnorm.trans hRk))
    obtain ⟨y, hy, hxy⟩ := (hN n hn).1 ⟨x, hxK⟩ hx
