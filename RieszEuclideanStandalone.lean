    {R : ℝ} (hR : 0 < R) (a : C(Euclidean d, X)) : C(X, ℝ) →L[ℝ] ℝ :=
  (boxAverageLinear hR a).mkContinuous 1 (fun f => by simpa using norm_boxAverageLinear_le hR a f)
