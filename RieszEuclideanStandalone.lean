/-- Two nonproportional nonzero real functionals give a surjective map to ℝ². -/
theorem prod_functionals_surjective {n : ℕ}
    (L M : Euclidean n →L[ℝ] ℝ) (hL : L ≠ 0)
    (hM : ∀ c : ℝ, M ≠ c • L) : Function.Surjective (L.prod M) := by
  classical
