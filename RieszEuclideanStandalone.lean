    {Λ : C_c(X, ℝ) →ₗ[ℝ] ℝ} (hΛ : ∀ f, 0 ≤ f → 0 ≤ Λ f) (h1 : Λ (ContinuousMap.liftCompactlySupported (ContinuousMap.const X 1)) = 1) :
