  have hi : euclideanBox d (R - boxNorm z) ⊆ euclideanBox d R :=
    euclideanBox_mono (by linarith [boxNorm_nonneg z])
  have ho : euclideanBox d R ⊆ euclideanBox d (R + boxNorm z) :=
    euclideanBox_mono (by linarith [boxNorm_nonneg z])
