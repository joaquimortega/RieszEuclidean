    exact DFunLike.ne_iff.mpr ⟨v, inner_self_ne_zero.mpr hv⟩
  · exact continuous_inner
  · intro y
    simpa only [BoundedContinuousFunction.char_apply, bilinFormOfRealInner_apply_apply,
