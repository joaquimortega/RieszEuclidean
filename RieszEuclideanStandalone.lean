    (hRmi : Rm.comp Rm = Rm) (hRpi : Rp.comp Rp = Rp)
    (hRmn : ∀ f, ‖Rm f‖ ^ 2 = ∫ θ, ‖cutoffSymbol Ω t₀ θ‖ ^ 2 ∂σ f)
    (hRpn : ∀ f, ‖Rp f‖ ^ 2 = ∫ θ, ‖interiorBoundarySymbol Ω t₀ θ‖ ^ 2 ∂σ f)
    (u : H) (hu : ‖u‖ = 1) (hσu : σ u = Measure.dirac 0) :
