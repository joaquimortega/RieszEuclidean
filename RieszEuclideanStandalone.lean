theorem singletonSupportingFace_of_local {d : ℕ} {K : Set (Euclidean d)}
    (hc : Convex ℝ K) {x v : Euclidean d} (hx : x ∈ K)
    (hlocal : ∀ᶠ z in nhds x, z ∈ K →
