/-- The L² norm is the integral of the squared modulus of its representative. -/
theorem fullL2_norm_sq_integral {d : ℕ} (f : FullL2 d) :
    ‖f‖ ^ 2 = ∫ x, ‖f x‖ ^ 2 := by
