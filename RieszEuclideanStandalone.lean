include hr hs in
omit [MeasurableSpace (hull Γ)] [BorelSpace (hull Γ)] in
/-- The integrated coefficient is exactly the original stationary coefficient. -/
theorem integral_comparisonProductCoefficient (hn : (∫ x, ‖b x‖ ^ 2) = 1) (v : Euclidean d) :
