theorem continuous_stationaryCoefficient {d : ℕ} {δ : ℝ} (hδ : 0 < δ)
    (Γ : SeparatedConfiguration d δ) (b : Euclidean d → ℂ)
    (hb : Continuous b) (hc : HasCompactSupport b) :
