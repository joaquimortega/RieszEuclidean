/-- Smoothed Fejér cutoffs are measurable functions of the spatial parameter. -/
theorem measurable_fejerCutoff {d : ℕ} {Ω : Set (Euclidean d)}
    (hΩ : MeasurableSet Ω) {R : ℝ} (hR : 0 < R) :
