/-- Restriction keeps the same representative on the restricted measure. -/
theorem domainRestriction_coe {d : ℕ} (Ω : Set (Euclidean d)) (f : FullL2 d) :
    (domainRestriction Ω f : Euclidean d → ℂ) =ᵐ[volume.restrict Ω] f :=
  MemLp.coeFn_toLp _
