  apply le_antisymm
  · apply A.opNorm_le_bound (norm_nonneg B)
    intro f
    obtain ⟨g, rfl⟩ := hT f
    rw [h, T.norm_map, T.norm_map]
    exact B.le_opNorm g
  · apply B.opNorm_le_bound (norm_nonneg A)
    intro f
    have ht := A.le_opNorm (T f)
    rwa [h, T.norm_map, T.norm_map] at ht
