    (hnorm : ∀ t f, ‖P t f‖ ^ 2 = ∫ θ, ‖cutoffSymbol Ω t θ‖ ^ 2 ∂σ f)
    (hdiff : ∀ s t f, ‖P s f - P t f‖ ^ 2 =
