    have ht := dist_triangle x a y
    rw [dist_comm x a] at ht
    linarith
  have hs := hsep N ha hb hab
  have ht₁ := dist_triangle a x b
  have ht₂ := dist_triangle x y b
  rw [dist_comm y b] at ht₂
  linarith

end RieszEuclidean

