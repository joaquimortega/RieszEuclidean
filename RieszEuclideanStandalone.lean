        (volume.real (euclideanBox d R) : ℂ)⁻¹ := by
      rw [← Complex.ofReal_pow, inv_pow, Real.sq_sqrt (show 0 ≤ volume.real (euclideanBox d R) from ENNReal.toReal_nonneg),
        Complex.ofReal_inv]
