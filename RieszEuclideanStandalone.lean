    {C : ℕ → Closeds α} {D : Closeds α}
    (h : Tendsto C atTop (nhds D))
    (hs : ∀ n, ∀ ⦃x⦄, x ∈ C n → ∀ ⦃y⦄, y ∈ C n → x ≠ y → δ ≤ dist x y) :
    ∀ ⦃x⦄, x ∈ D → ∀ ⦃y⦄, y ∈ D → x ≠ y → δ ≤ dist x y := by
