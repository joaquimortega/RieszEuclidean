theorem integrable_stationaryEnvelope_moment (d : ℕ) (r M : ℝ) :
    Integrable (fun y : Euclidean d => ‖y‖ * stationaryEnvelope r M y) := by
  have hh : Integrable ((Metric.closedBall (0 : Euclidean d) (2 * r)).indicator
