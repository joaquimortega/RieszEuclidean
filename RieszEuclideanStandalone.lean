        (stationaryKernelOperator hδ Γ μ hμ hr b hs hM hb (-y) hmn g) Δ)
  rw [hΔ, hUΔ, hfΔ]
  simp only [Function.comp_apply]
  rw [hgΔ, he]
  change inner (𝕜 := ℂ) (stationaryKernel b y Δ.val * f (hullTranslate hδ Γ (-y) Δ)) (g Δ) =
    inner (𝕜 := ℂ) (f (hullTranslate hδ Γ (-y) Δ))
