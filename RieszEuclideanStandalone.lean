  change inner (𝕜 := ℂ)
    (stationaryKernelOperator hδ Γ μ hμ hr b hs hM hb y hm f Δ) (g Δ) =
    inner (𝕜 := ℂ) (Lp.compMeasurePreserving (hullTranslate hδ Γ (-y)) (hμ (-y)) f Δ)
