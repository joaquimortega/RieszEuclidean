  ext x
  simp only [strictHalfspaceIntersection, Set.mem_setOf_eq, normalizedSupportNormal,
    normalizedSupportOffset, inner_smul_right]
  exact forall_congr' fun i => mul_lt_mul_left (inv_pos.mpr (norm_pos_iff.mpr (hn i)))

