  have hxR : ‖x‖ < R := by dsimp [R]; linarith [le_max_left ‖x‖ ‖y‖]
  have hyR : ‖y‖ < R := by dsimp [R]; linarith [le_max_right ‖x‖ ‖y‖]
  obtain ⟨N, hN⟩ := h R hR ε hε
  obtain ⟨a, ha, hax⟩ := (hN N le_rfl).2 x hx hxR
  obtain ⟨b, hb, hby⟩ := (hN N le_rfl).2 y hy hyR
