  calc
    _ = ∫ v, ∫ w, domainKernel Ω (v - w) * averagedTest R t T f x w *
        star (averagedTest R t T g x v) := by
      apply integral_congr_ae
      filter_upwards [hjg] with v hv
      apply integral_congr_ae
      filter_upwards [hjf] with w hw
