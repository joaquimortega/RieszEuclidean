      (μ := σ) (l := l ×ˢ l)
      (F := fun p θ => ‖integratedKernelSymbol (a p.1) θ -
        integratedKernelSymbol (a p.2) θ‖ ^ 2)
      (f := fun _ : Euclidean d => (0 : ℝ))
