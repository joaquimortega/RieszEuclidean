theorem box_translation_error_tendsto_zero {d : ℕ} {g : Euclidean d → ℝ} (hg : Continuous g)
    {C : ℝ} (hC : ∀ x, ‖g x‖ ≤ C) (z : Euclidean d) :
    Tendsto (fun R : ℝ => (∫ y, g (y + z) ∂boxProbabilityMeasure d R) -
