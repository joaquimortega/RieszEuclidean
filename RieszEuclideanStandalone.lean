theorem schwartz_fourier_norm {d : ℕ} (f : SchwartzMap (Euclidean d) ℂ) :
    ‖(SchwartzMap.fourierTransformCLM ℂ f).toLp 2‖ = ‖f.toLp 2‖ := by
  have h := congrArg Complex.re (schwartz_fourier_inner f f)
