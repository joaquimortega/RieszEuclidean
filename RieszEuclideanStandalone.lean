    (fun n => P (tm n)) (fun n => P (tp n))
    (fun n => M (tm n)) (fun n => M (tp n)) Rminus Rplus Q γ hγ
    hRmt hRpt (hM.tendsto.comp htm) (hM.tendsto.comp htp)
    (fun n => hgap (tm n)) (fun n => hgap (tp n)) hstrict
end RieszEuclidean
