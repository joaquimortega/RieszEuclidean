theorem bumpKernel_hermitian {d : ℕ} (Γ : Set (Euclidean d))
    (b : Euclidean d → ℂ) (v w : Euclidean d) :
    bumpKernel Γ b w v = star (bumpKernel Γ b v w) := by
  rw [bumpKernel, bumpKernel, tsum_star]
  apply tsum_congr
  intro i
  simp [mul_comm]

