            ∫ w, (a y * b w) • U (y + w) f := by
          simpa using (integral_add_left_eq_self
            (fun x => (a y * b (x - y)) • U x f) y).symm
        _ = ∫ w, a y • U y (b w • U w f) := by
          apply integral_congr_ae
          filter_upwards [] with w
          rw [map_smul, hadd, mul_smul]
