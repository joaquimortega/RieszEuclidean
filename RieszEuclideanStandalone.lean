    (fun y : Euclidean d => (fejerWeight R y : ℂ)) =
      fun y => (volume.real (euclideanBox d R) : ℂ)⁻¹ *
        integratedKernelConvolution ((euclideanBox d R).indicator (fun _ => (1 : ℂ)))
