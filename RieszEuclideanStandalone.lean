  change (∫ y, star (a (-y)) * (Real.fourierChar (inner (𝕜 := ℝ) y θ) : ℂ)) = _
  calc
    (∫ y, star (a (-y)) * (Real.fourierChar (inner (𝕜 := ℝ) y θ) : ℂ)) =
        ∫ y, star (a y) * (Real.fourierChar (inner (𝕜 := ℝ) (-y) θ) : ℂ) := by
      simpa using (integral_neg_eq_self
