  obtain ⟨i, hi⟩ := odd_strictSupportingFaces_exists_unpaired normal offset hunit hface hodd
  refine ⟨i, fun a b hab ha hb j hji => ?_⟩
  apply planar_inner_ne_zero_of_not_parallel (b - a) (normal i) (normal j)
