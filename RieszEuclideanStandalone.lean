    convert (hb.ofReal (𝕜 := ℂ)).comp_sub_right (i : Euclidean d) using 1
    ext u
    rw [mul_comm]
    exact (RCLike.mul_conj (b (u - i))).trans (Complex.ofReal_pow _ _).symm
