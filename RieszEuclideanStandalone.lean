    (f : DomainL2 Ω) : (domainExtension Ω hΩ f : Euclidean d → ℂ) =ᵐ[volume] Ω.indicator f :=
  MemLp.coeFn_toLp _
/-- Zero extension preserves the L² norm. -/
theorem domainExtension_norm {d : ℕ} (Ω : Set (Euclidean d)) (hΩ : MeasurableSet Ω)
