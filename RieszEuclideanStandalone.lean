      t ∈ closure Ω ∧ t ∈ closure (closure Ω)ᶜ := by
  haveI : NeZero ν := ⟨hν⟩
  have htranslate (θ : Euclidean d) (hθ : θ ≠ 0) : ν {t | t + θ ∈ frontier Ω} = 0 := by
