theorem tendsto_fejerModulatedOperator_error (A : Euclidean d → H →L[ℂ] H)
    (hA : ∀ f, AEStronglyMeasurable (fun y => A y f) volume)
    {C : Euclidean d → ℝ} (hC : Integrable C) (hbound : ∀ y, ‖A y‖ ≤ C y)
