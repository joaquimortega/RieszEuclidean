  obtain ⟨S, hS⟩ := hB
  obtain ⟨c, hc, hcols⟩ := synthesis_columns_separated S
  obtain ⟨R, hR, hbound⟩ := hb.exists_pos_norm_le
  haveI : IsFiniteMeasure (volume.restrict Ω) := ⟨by simpa using hb.measure_lt_top (μ := volume)⟩
