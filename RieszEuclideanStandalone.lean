theorem l2Multiplier_inv_mul {α : Type} [MeasurableSpace α] {μ : Measure α}
    (m : α → ℂ) (hm : AEStronglyMeasurable m μ) {C D : ℝ}
    (hC : ∀ᵐ x ∂μ, ‖m x‖ ≤ C) (hD : ∀ᵐ x ∂μ, ‖(m x)⁻¹‖ ≤ D)
