  let K : ℝ := M * (4 * Real.pi * R)
  have hK : 0 ≤ K := by dsimp [K]; positivity
  let A : ℝ := 2 * Real.pi * R
  have hA : 0 ≤ A := by dsimp [A]; positivity
  let δ := min (1 / (A + 1)) (c / (K + 1))
