  have h : Tendsto (fun R : ℝ => (1 + c / R) ^ d - (1 - c / R) ^ d) atTop (nhds 0) := by
    have h1 : Tendsto (fun _ : ℝ => (1 : ℝ)) atTop (nhds 1) := tendsto_const_nhds
